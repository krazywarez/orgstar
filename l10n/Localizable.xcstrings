    "Clocks out of the running clock, or back in to the entry clocked last.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet die laufende Zeiterfassung oder startet sie wieder für den zuletzt erfassten Eintrag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene el registro de tiempo en curso o lo reanuda en la última entrada registrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le chronométrage en cours, ou le relance sur la dernière entrée chronométrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のクロックをクロックアウトするか、最後にクロックしたエントリに再度クロックインします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o registro de tempo em andamento ou o reinicia na última entrada registrada."
          }
        }
      }
    },
