    "Subscriptions renew automatically until cancelled in your Apple Account settings, at least 24 hours before the period ends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnements verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums in den Einstellungen deines Apple Accounts gekündigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente salvo que se cancelen en los ajustes de tu cuenta de Apple al menos 24 horas antes de que finalice el periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements sont renouvelés automatiquement, sauf s'ils sont annulés dans les réglages de votre compte Apple au moins 24 heures avant la fin de la période en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは、期間終了の24時間以上前にApple Accountの設定でキャンセルしない限り、自動的に更新されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas são renovadas automaticamente até serem canceladas nos ajustes da sua Conta Apple, com pelo menos 24 horas de antecedência do fim do período."
          }
        }
      }
    },
