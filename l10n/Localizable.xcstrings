          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgstar não consegue manter o acesso a %@."
          }
        }
      }
    },
    "orgstar can't open this folder": {
      "localizations": {
        "de": {
