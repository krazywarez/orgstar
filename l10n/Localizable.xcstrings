    "Speed keys: single letters at the start of a heading line run commands (org-use-speed-commands)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelltasten: Einzelne Buchstaben am Anfang einer Überschriftszeile führen Befehle aus (org-use-speed-commands)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas rápidas: letras sueltas al principio de una línea de encabezado ejecutan comandos (org-use-speed-commands)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
