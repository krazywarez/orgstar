    "Applies to files as they open. View ▸ Truncate or Wrap Long Lines switches the current file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für Dateien beim Öffnen. Darstellung ▸ Lange Zeilen abschneiden oder umbrechen schaltet die aktuelle Datei um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a los archivos al abrirlos. Visualización ▸ Truncar o ajustar líneas largas cambia el archivo actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique aux fichiers à leur ouverture. Présentation ▸ Tronquer ou renvoyer à la ligne les lignes longues modifie le réglage du fichier actuel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを開くときに適用されます。「表示」▸「長い行を切り詰める/折り返す」で現在のファイルを切り替えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se aos arquivos quando são abertos. Visualizar ▸ Truncar ou Quebrar Linhas Longas alterna o arquivo atual."
          }
        }
      }
    },
