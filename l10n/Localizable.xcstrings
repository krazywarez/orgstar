    "Under a parent with the ORDERED property (Toggle ORDERED Property, C-c C-x o), TODO children are also done in order.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter einem Eintrag mit der Eigenschaft ORDERED (ORDERED umschalten, C-c C-x o) werden TODO-Untereinträge auch der Reihe nach erledigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajo una entrada padre con la propiedad ORDERED (Toggle ORDERED Property, C-c C-x o), las hijas TODO también se completan en orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous un parent ayant la propriété ORDERED (Basculer la propriété ORDERED, C-c C-x o), les sous-entrées TODO sont aussi terminées dans l'ordre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ORDEREDプロパティを持つ親（ORDEREDプロパティを切り替え、C-c C-x o）の下では、TODOの子エントリも順番に完了する必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sob um pai com a propriedade ORDERED (Alternar Propriedade ORDERED, C-c C-x o), os filhos TODO também são concluídos em ordem."
          }
        }
      }
    },
