          }
        }
      }
    },
    "Spell checking applies to files as they open; Check Spelling While Typing switches the current file. Code, links, dates, tags and keywords aren't checked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rechtschreibprüfung gilt für Dateien beim Öffnen; „Rechtschreibung während der Eingabe prüfen“ schaltet die aktuelle Datei um. Code, Links, Daten, Tags und Schlüsselwörter werden nicht geprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisión ortográfica se aplica a los archivos al abrirlos; “Revisar ortografía al escribir” cambia el archivo actual. No se revisan el código, los enlaces, las fechas, las etiquetas ni las palabras clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification orthographique s'applique aux fichiers à leur ouverture ; Vérifier l'orthographe lors de la frappe modifie le réglage du fichier actuel. Le code, les liens, les dates, les tags et les mots-clés ne sont pas vérifiés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペルチェックはファイルを開くときに適用されます。「入力中にスペルチェック」で現在のファイルを切り替えます。コード、リンク、日付、タグ、キーワードはチェックされません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação ortográfica se aplica aos arquivos quando são abertos; Verificar Ortografia ao Digitar alterna o arquivo atual. Código, links, datas, etiquetas e palavras-chave não são verificados."
          }
        }
      }
    },
