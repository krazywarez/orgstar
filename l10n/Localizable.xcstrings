    "The theme file %@ sets colors over these, and config.toml's colors apply on top of both.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Themendatei %@ legt Farben über diese, und die Farben aus config.toml gelten zusätzlich zu beiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de tema %@ define colores por encima de estos, y los colores de config.toml se aplican por encima de ambos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de thème %@ définit des couleurs par-dessus celles-ci, et les couleurs de config.toml s'appliquent par-dessus les deux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマファイル%@がこれらの上に色を設定し、config.tomlの色はさらにその上に適用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de tema %@ define cores por cima destas, e as cores de config.toml são aplicadas por cima de ambos."
          }
        }
      }
    },
    "The whole file is removed. Files in iCloud Drive go to Recently Deleted in the Files app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ganze Datei wird entfernt. Dateien in iCloud Drive kommen in der Dateien-App unter „Zuletzt gelöscht“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina el archivo entero. Los archivos de iCloud Drive van a Eliminado recientemente en la app Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier entier est supprimé. Les fichiers dans iCloud Drive vont dans Suppressions récentes dans l'app Fichiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル全体が削除されます。iCloud Driveのファイルは、「ファイル」Appの「最近削除した項目」に移動します。"
          }
        },
        "pt-BR": {
