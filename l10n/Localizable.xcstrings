          }
        }
      }
    },
    "Entries can't be done with unchecked boxes (org-enforce-todo-checkbox-dependencies)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge mit offenen Kontrollkästchen sind nicht erledigt (org-enforce-todo-checkbox-dependencies)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entradas no pueden completarse con casillas sin marcar (org-enforce-todo-checkbox-dependencies)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une entrée ne peut pas être terminée avec des cases non cochées (org-enforce-todo-checkbox-dependencies)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
