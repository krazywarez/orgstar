    "Leaves folders out of the agenda and widgets, and mutes their reminders, while this Focus is on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt Ordner aus der Agenda und den Widgets weg und stellt ihre Erinnerungen stumm, solange dieser Fokus aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluye carpetas de la agenda y los widgets, y silencia sus recordatorios, mientras este modo de concentración esté activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclut des dossiers de l'agenda et des widgets, et met leurs rappels en sourdine, tant que ce mode de concentration est activé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この集中モードがオンの間、フォルダをアジェンダとウィジェットから除外し、その通知を消音します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa pastas fora da agenda e dos widgets e silencia seus lembretes enquanto este Foco estiver ativado."
          }
        }
      }
    },
