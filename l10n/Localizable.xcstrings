    "The Watch app needs orgstar+. Get it in orgstar on your iPhone, in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Watch-App erfordert orgstar+. Du erhältst es in orgstar auf deinem iPhone, unter Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app para Watch requiere orgstar+. Consíguelo en orgstar en tu iPhone, en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
