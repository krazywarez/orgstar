    "orgstar+ is a one-time purchase of $39.99 for this Mac. Editing, the agenda, capture, clocking and search stay free.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar+ ist ein einmaliger Kauf für $39.99 für diesen Mac. Bearbeiten, Agenda, Erfassen, Zeiterfassung und Suche bleiben kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar+ es una compra única de $39.99 para este Mac. La edición, la agenda, la captura, el registro de tiempo y la búsqueda siguen siendo gratuitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar+ est un achat unique de $39.99 pour ce Mac. L'édition, l'agenda, la capture, le chronométrage et la recherche restent gratuits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar+はこのMac用の$39.99の買い切り型購入です。編集、アジェンダ、キャプチャ、クロック、検索は引き続き無料です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgstar+ é uma compra única de $39.99 para este Mac. A edição, a agenda, a captura, o registro de tempo e a busca continuam gratuitos."
          }
        }
      }
    },
