    "%@ isn't in one of your folders, so it can't be moved. Attach a copy instead.": {
      "comment": "Attach by moving a file from outside the sidebar's folders",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt in keinem deiner Ordner und kann daher nicht bewegt werden. Hänge stattdessen eine Kopie an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está en ninguna de tus carpetas, así que no se puede mover. Adjunta una copia en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne se trouve dans aucun de vos dossiers et ne peut donc pas être déplacé. Joignez plutôt une copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はどのフォルダにもないため、移動できません。代わりにコピーを添付してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está em nenhuma das suas pastas, então não pode ser movido. Anexe uma cópia em vez disso."
          }
        }
      }
    },
