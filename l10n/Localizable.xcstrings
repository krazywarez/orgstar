    "The agenda reads the org files at the top of each folder you add.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Agenda liest die Org-Dateien auf der obersten Ebene jedes hinzugefügten Ordners."
          }
        }
      }
    },
    "The empty folder is removed from disk and from orgstar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der leere Ordner wird von der Festplatte und aus orgstar entfernt."
