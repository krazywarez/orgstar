      }
    },
    "orgstar can notify you before timed entries, as Org's appointment reminders do, and show today's overdue count on its icon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar kann dich vor Einträgen mit Uhrzeit benachrichtigen, wie Orgs Terminerinnerungen, und die Zahl der heute überfälligen Einträge auf dem Symbol zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar puede avisarte antes de las entradas con hora, como los recordatorios de citas de Org, y mostrar en su icono el número de entradas vencidas de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar peut vous notifier avant les entrées avec heure, comme les rappels de rendez-vous d'Org, et afficher sur son icône le nombre d'entrées en retard aujourd'hui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstarは、Orgの予定リマインダーと同様に時刻指定のエントリの前に通知し、今日の期限切れの数をアイコンに表示できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgstar pode notificar você antes de entradas com horário, como os lembretes de compromissos do Org, e mostrar o número de atrasados de hoje no ícone."
          }
        }
      }
    },
    "orgstar edits a folder of plain-text org files in place. Add the folder your notes are in, or start a new one. Nothing is copied or moved, and you can add more folders later with File ▸ Add Folder….": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar bearbeitet einen Ordner mit Org-Dateien im Klartext direkt. Füge den Ordner mit deinen Notizen hinzu oder beginne einen neuen. Nichts wird kopiert oder verschoben, und mit Ablage ▸ Ordner hinzufügen … kannst du später weitere Ordner hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar edita en su sitio una carpeta de archivos Org en texto plano. Añade la carpeta donde están tus notas o empieza una nueva. No se copia ni se mueve nada, y puedes añadir más carpetas después con Archivo ▸ Añadir carpeta…."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar modifie sur place un dossier de fichiers Org en texte brut. Ajoutez le dossier contenant vos notes, ou commencez-en un nouveau. Rien n'est copié ni déplacé, et vous pourrez ajouter d'autres dossiers plus tard avec Fichier ▸ Ajouter un dossier…."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstarは、プレーンテキストのOrgファイルのフォルダをその場で編集します。メモがあるフォルダを追加するか、新しく始めましょう。何もコピーや移動はされません。あとでファイル ▸ フォルダを追加…でほかのフォルダも追加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgstar edita uma pasta de arquivos Org em texto simples no próprio lugar. Adicione a pasta onde estão suas notas ou comece uma nova. Nada é copiado ou movido, e você pode adicionar mais pastas depois com Arquivo ▸ Adicionar Pasta…."
          }
        }
      }
    },
    "orgstar files it with a template when you next open it on iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar legt es beim nächsten Öffnen auf dem iPhone mit einer Vorlage ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar lo clasificará con una plantilla la próxima vez que lo abras en el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar le classera avec un modèle à sa prochaine ouverture sur l'iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にiPhoneでorgstarを開いたときに、テンプレートを使って振り分けられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgstar o guarda com um modelo na próxima vez que você o abrir no iPhone."
          }
        }
      }
    },
    "orgstar files it with the template when you next open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar legt es beim nächsten Öffnen mit der Vorlage ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar lo clasificará con la plantilla la próxima vez que lo abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar le classera avec le modèle à sa prochaine ouverture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にorgstarを開いたときに、そのテンプレートを使って振り分けられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgstar o guarda com o modelo na próxima vez que você o abrir."
          }
        }
      }
    },
    "orgstar's shared folder isn't available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gemeinsame Ordner von orgstar ist nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta compartida de orgstar no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier partagé d'orgstar n'est pas disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstarの共有フォルダを利用できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta compartilhada do orgstar não está disponível."
          }
        }
      }
    },
