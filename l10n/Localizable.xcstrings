    "Keyword flags such as DONE(d!) and #+STARTUP words in a file override these. org-log-reschedule and org-log-redeadline are in config.toml.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselwort-Markierungen wie DONE(d!) und #+STARTUP-Wörter in einer Datei haben Vorrang. org-log-reschedule und org-log-redeadline stehen in config.toml."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los indicadores de palabra clave como DONE(d!) y las palabras de #+STARTUP de un archivo tienen prioridad sobre estos. org-log-reschedule y org-log-redeadline están en config.toml."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les indicateurs de mots-clés comme DONE(d!) et les mots #+STARTUP d'un fichier ont priorité sur ces réglages. org-log-reschedule et org-log-redeadline se trouvent dans config.toml."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DONE(d!)などのキーワードフラグや、ファイル内の#+STARTUPの語はこれらより優先されます。org-log-rescheduleとorg-log-redeadlineはconfig.tomlにあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicadores de palavras-chave como DONE(d!) e palavras #+STARTUP em um arquivo têm prioridade sobre estes. org-log-reschedule e org-log-redeadline estão em config.toml."
          }
        }
      }
    },
