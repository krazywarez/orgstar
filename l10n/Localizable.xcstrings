    "%@\n\nThe heading and every line under it are removed from the file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nDie Überschrift und jede Zeile darunter werden aus der Datei entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nEl encabezado y todas las líneas debajo se eliminan del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nLe titre et toutes les lignes situées en dessous sont supprimés du fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n見出しとその下のすべての行がファイルから削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nO cabeçalho e todas as linhas abaixo dele são removidos do arquivo."
          }
        }
      }
    },
