    },
    "The file changed on disk, and the changes conflict with yours": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde auf der Festplatte geändert, und die Änderungen widersprechen deinen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo ha cambiado en el disco y los cambios entran en conflicto con los tuyos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a été modifié sur le disque, et ces modifications entrent en conflit avec les vôtres"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク上のファイルが変更され、その変更があなたの変更と競合しています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo foi alterado no disco, e as alterações conflitam com as suas"
          }
        }
      }
    },
    "The folder and its files stay on disk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner und seine Dateien bleiben auf der Festplatte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta y sus archivos permanecen en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier et ses fichiers restent sur le disque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダとそのファイルはディスクに残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta e seus arquivos permanecem no disco."
          }
        }
