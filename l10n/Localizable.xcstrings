    "The icon shows in the Dock while orgstar runs. Finder, and the Dock after orgstar quits, show the default icon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol erscheint im Dock, solange orgstar läuft. Der Finder und das Dock nach dem Beenden zeigen das Standardsymbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono aparece en el Dock mientras orgstar está abierto. El Finder, y el Dock después de salir de orgstar, muestran el icono por omisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icône s'affiche dans le Dock pendant l'exécution d'orgstar. Le Finder, et le Dock après la fermeture d'orgstar, affichent l'icône par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstarの実行中はDockにこのアイコンが表示されます。Finderと、orgstar終了後のDockにはデフォルトのアイコンが表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone aparece no Dock enquanto o orgstar está aberto. O Finder, e o Dock depois que o orgstar é encerrado, mostram o ícone padrão."
          }
        }
      }
    },
    "The next agenda entry, or how many are open today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der nächste Agenda-Eintrag oder wie viele heute offen sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La siguiente entrada de la agenda, o cuántas quedan pendientes hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine entrée de l'agenda, ou le nombre d'entrées à faire aujourd'hui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のアジェンダエントリ、または今日の未完了件数。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima entrada da agenda ou quantas estão em aberto hoje."
          }
        }
      }
    },
    "The running clock and its time so far.": {
      "localizations": {
        "de": {
