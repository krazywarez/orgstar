          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ordner mit deinen Org-Dateien, in iCloud Drive oder bei einem anderen Anbieter. orgstar liest und schreibt sie dort; nichts wird kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la carpeta que contiene tus archivos Org, en iCloud Drive u otro proveedor. orgstar los lee y escribe ahí; no se copia nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le dossier contenant vos fichiers Org, dans iCloud Drive ou chez un autre fournisseur. orgstar les lit et les écrit à cet endroit ; rien n'est copié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Driveまたはほかのプロバイダで、Orgファイルがあるフォルダを選択してください。orgstarはその場所で読み書きし、何もコピーしません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a pasta que contém seus arquivos Org, no iCloud Drive ou em outro provedor. O orgstar os lê e grava ali; nada é copiado."
          }
        }
      }
    },
