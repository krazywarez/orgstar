    "The agenda reads the org files at the top of each folder you add.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Agenda liest die Org-Dateien auf der obersten Ebene jedes hinzugefügten Ordners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La agenda lee los archivos Org del nivel superior de cada carpeta que añades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agenda lit les fichiers Org à la racine de chaque dossier ajouté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アジェンダは、追加した各フォルダの最上位にあるOrgファイルを読み込みます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A agenda lê os arquivos Org do nível superior de cada pasta adicionada."
          }
        }
      }
    },
    "The empty folder is removed from disk and from orgstar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der leere Ordner wird von der Festplatte und aus orgstar entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta vacía se elimina del disco y de orgstar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier vide est supprimé du disque et d'orgstar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のフォルダがディスクとorgstarから削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta vazia é removida do disco e do orgstar."
          }
        }
      }
    },
    "The empty folder is removed.": {
      "localizations": {
