    "Entries can't be done before their TODO children (org-enforce-todo-dependencies)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge sind erst nach ihren TODO-Untereinträgen erledigt (org-enforce-todo-dependencies)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entradas no pueden completarse antes que sus hijas TODO (org-enforce-todo-dependencies)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une entrée ne peut pas être terminée avant ses sous-entrées TODO (org-enforce-todo-dependencies)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TODOの子エントリが完了するまでエントリを完了にできない（org-enforce-todo-dependencies）"
          }
        },
        "pt-BR": {
