    "orgstar": {
      "shouldTranslate": false
    },
    "orgstar asks which entry to attach them to when you next open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar fragt beim nächsten Öffnen, an welchen Eintrag sie angehängt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar te preguntará a qué entrada adjuntarlos la próxima vez que lo abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar vous demandera à quelle entrée les joindre à sa prochaine ouverture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に開いたときに、どのエントリに添付するかをorgstarが確認します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgstar pergunta a qual entrada anexá-los na próxima vez que você o abrir."
          }
        }
      }
    },
    "orgstar can notify you before timed entries, as Org's appointment reminders do, and show today's overdue count on its icon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar kann dich vor Einträgen mit Uhrzeit benachrichtigen, wie Orgs Terminerinnerungen, und die Zahl der heute überfälligen Einträge auf dem Symbol zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar puede avisarte antes de las entradas con hora, como los recordatorios de citas de Org, y mostrar en su icono el número de entradas vencidas de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar peut vous notifier avant les entrées avec heure, comme les rappels de rendez-vous d'Org, et afficher sur son icône le nombre d'entrées en retard aujourd'hui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstarは、Orgの予定リマインダーと同様に時刻指定のエントリの前に通知し、今日の期限切れの数をアイコンに表示できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgstar pode notificar você antes de entradas com horário, como os lembretes de compromissos do Org, e mostrar o número de atrasados de hoje no ícone."
          }
        }
      }
    },
    "orgstar can't keep %@ as the configuration folder.": {
      "comment": "Alert when the chosen configuration folder can't be saved",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar kann %@ nicht als Konfigurationsordner behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar no puede conservar %@ como carpeta de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstar ne peut pas conserver %@ comme dossier de configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "orgstarは%@を設定フォルダとして保持できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgstar não consegue manter %@ como pasta de configuração."
          }
