            "value": "Er liegt in keinem deiner Ordner. Erlaube den Zugriff, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está en ninguna de tus carpetas. Concede acceso para continuar."
