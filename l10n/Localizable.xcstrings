    "Lines marked - are in the buffer, + in the kept version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit - markierte Zeilen stehen im Puffer, mit + in der aufbewahrten Version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas marcadas con - están en el búfer, y con + en la versión conservada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes marquées - sont dans le tampon, + dans la version conservée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "-が付いた行はバッファ内、+が付いた行は保持されたバージョン内にあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas marcadas com - estão no buffer, e com + na versão mantida."
          }
        }
      }
    },
    "Lines marked - are in the file, + in the copy. The copy goes to the recovery folder when it's resolved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit - markierte Zeilen stehen in der Datei, mit + in der Kopie. Die Kopie kommt nach dem Auflösen in den Wiederherstellungsordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas marcadas con - están en el archivo, y con + en la copia. La copia pasa a la carpeta de recuperación al resolverse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes marquées - sont dans le fichier, + dans la copie. La copie va dans le dossier de récupération une fois le conflit résolu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "-が付いた行はファイル内、+が付いた行はコピー内にあります。解決すると、コピーは復元フォルダに移動します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas marcadas com - estão no arquivo, e com + na cópia. A cópia vai para a pasta de recuperação quando o conflito é resolvido."
          }
        }
      }
    },
