    "A folder with config.toml and capture.toml, such as a synced copy of ~/.config/orgstar from your Mac. Changes to them apply as they sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ordner mit config.toml und capture.toml, etwa eine synchronisierte Kopie von ~/.config/orgstar auf deinem Mac. Änderungen daran gelten, sobald sie synchronisiert sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carpeta con config.toml y capture.toml, como una copia sincronizada de ~/.config/orgstar de tu Mac. Los cambios en ellos se aplican al sincronizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier contenant config.toml et capture.toml, comme une copie synchronisée de ~/.config/orgstar depuis votre Mac. Les modifications s'appliquent dès leur synchronisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "config.tomlとcapture.tomlを含むフォルダ。Macの~/.config/orgstarを同期したコピーなど。変更は同期され次第適用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pasta com config.toml e capture.toml, como uma cópia sincronizada de ~/.config/orgstar do seu Mac. As alterações neles são aplicadas à medida que são sincronizadas."
          }
        }
      }
    },
