            "value": "Die Eigenschaft APPT_WARNTIME eines Eintrags ersetzt die Vorlaufzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propiedad APPT_WARNTIME de una entrada sustituye la antelación."
