        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos de arquivamento são aqueles para os quais seus arquivos da agenda arquivam, definidos por #+ARCHIVE:, uma propriedade :ARCHIVE: ou org-archive-location."
          }
        }
      }
    },
