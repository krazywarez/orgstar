        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demande une réponse ; exécutez la commande dans l'entrée elle-même"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は入力が必要です。エントリ上で直接実行してください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ precisa de uma resposta; execute o comando na própria entrada"
          }
        }
      }
