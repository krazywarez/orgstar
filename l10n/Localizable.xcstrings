    "Archive files are the ones your agenda files archive to, named by #+ARCHIVE:, an :ARCHIVE: property or org-archive-location.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivdateien sind die Dateien, in die deine Agenda-Dateien archivieren, festgelegt durch #+ARCHIVE:, eine :ARCHIVE:-Eigenschaft oder org-archive-location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
