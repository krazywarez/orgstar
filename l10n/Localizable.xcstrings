            "value": "TODOの子エントリが完了するまでエントリを完了にできない（org-enforce-todo-dependencies）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As entradas não podem ser concluídas antes dos filhos TODO (org-enforce-todo-dependencies)"
          }
        }
      }
    },
    "Entries can't be done with unchecked boxes (org-enforce-todo-checkbox-dependencies)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge mit offenen Kontrollkästchen sind nicht erledigt (org-enforce-todo-checkbox-dependencies)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
