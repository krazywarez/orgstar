    "Archive files are the ones your agenda files archive to, named by #+ARCHIVE:, an :ARCHIVE: property or org-archive-location.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivdateien sind die Dateien, in die deine Agenda-Dateien archivieren, festgelegt durch #+ARCHIVE:, eine :ARCHIVE:-Eigenschaft oder org-archive-location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de archivo son aquellos a los que archivan tus archivos de agenda, indicados por #+ARCHIVE:, una propiedad :ARCHIVE: u org-archive-location."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers d'archive sont ceux vers lesquels vos fichiers d'agenda archivent, désignés par #+ARCHIVE:, une propriété :ARCHIVE: ou org-archive-location."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブファイルとは、アジェンダファイルのアーカイブ先となるファイルで、#+ARCHIVE:、:ARCHIVE:プロパティ、またはorg-archive-locationで指定されます。"
          }
