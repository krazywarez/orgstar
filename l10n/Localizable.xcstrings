    "Incomplete reminders with a due date from the checked lists show in the agenda, read-only; overdue ones under today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Erinnerungen mit Fälligkeitsdatum aus den markierten Listen erscheinen schreibgeschützt in der Agenda; überfällige unter heute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios pendientes con fecha de vencimiento de las listas marcadas se muestran en la agenda, de solo lectura; los vencidos, en hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels non terminés avec une échéance des listes cochées s'affichent dans l'agenda, en lecture seule ; ceux en retard sous aujourd'hui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックしたリストの期限付き未完了リマインダーが、読み出し専用でアジェンダに表示されます。期限切れのものは今日の下に表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes não concluídos com data de vencimento das listas marcadas aparecem na agenda, somente leitura; os atrasados, em hoje."
          }
        }
      }
    },
    "Incomplete reminders with a due date show in the agenda read-only, overdue ones under today; double-click one to open it in Reminders.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Erinnerungen mit Fälligkeitsdatum erscheinen schreibgeschützt in der Agenda, überfällige unter heute; doppelklicke eine, um sie in Erinnerungen zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios pendientes con fecha de vencimiento se muestran en la agenda, de solo lectura, y los vencidos, en hoy; haz doble clic en uno para abrirlo en Recordatorios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels non terminés avec une échéance s'affichent dans l'agenda en lecture seule, ceux en retard sous aujourd'hui ; double-cliquez sur l'un d'eux pour l'ouvrir dans Rappels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限付きの未完了リマインダーが読み出し専用でアジェンダに表示され、期限切れのものは今日の下に表示されます。ダブルクリックするとリマインダーで開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes não concluídos com data de vencimento aparecem na agenda, somente leitura, e os atrasados em hoje; clique duas vezes em um para abri-lo no Lembretes."
          }
        }
      }
    },
