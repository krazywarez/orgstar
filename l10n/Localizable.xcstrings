    "Change an entry's state, dates, tags and notes in place. Swipe to finish or reschedule.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Status, Termine, Tags und Notizen eines Eintrags direkt ändern. Wischen, um ihn abzuschließen oder zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el estado, las fechas, las etiquetas y las notas de una entrada sin salir de ella. Desliza para completarla o reprogramarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez l'état, les dates, les tags et les notes d'une entrée sur place. Balayez pour la terminer ou la replanifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エントリの状態、日付、タグ、メモをその場で変更できます。スワイプで完了または再スケジュールします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere o estado, as datas, as etiquetas e as notas de uma entrada no próprio lugar. Deslize para concluir ou reagendar."
          }
        }
      }
    },
